<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_sheet"
    android:padding="20dp">

    <!-- SHEET HANDLE -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_info_chip" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/detailIconContainer"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_quick_icon_circle">

            <ImageView
                android:id="@+id/ivDetailIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:contentDescription="@null"
                tools:src="@drawable/ic_tool_net_ping" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDetailToolName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/times_new_roman_bold"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Network Diagnostics" />

            <TextView
                android:id="@+id/tvDetailCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/times_new_roman_regular"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Cyber Tools" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/detailStatusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_info_chip">

            <ImageView
                android:id="@+id/ivDetailStatusIcon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_status_success"
                app:tint="@color/status_online" />

            <TextView
                android:id="@+id/tvDetailStatusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/times_new_roman_bold"
                android:textColor="@color/status_online"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="Success" />
        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="@color/border" />

    <!-- DETAILS GRID -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- TYPE & DURATION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/times_new_roman_bold"
                    android:text="ACTIVITY TYPE"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/tvDetailType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/times_new_roman_bold"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    tools:text="Executed" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/times_new_roman_bold"
                    android:text="DURATION"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/tvDetailDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/times_new_roman_bold"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    tools:text="4.2 sec" />
            </LinearLayout>

        </LinearLayout>

        <!-- TIMESTAMP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/times_new_roman_bold"
                android:text="TIMESTAMP"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/tvDetailTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/times_new_roman_regular"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                tools:text="Tuesday, October 14, 2026 · 14:32:05" />
        </LinearLayout>

        <!-- SUMMARY LOG -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/times_new_roman_bold"
            android:text="SUMMARY &amp; LOGS"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvDetailSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_info_chip"
            android:padding="12dp"
            android:fontFamily="@font/times_new_roman_regular"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            tools:text="Ping: 43ms · Packet Loss: 0% · Target: 1.1.1.1 reachable." />

    </LinearLayout>

    <!-- ACTIONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteDetail"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Delete"
            android:textColor="@color/accent_muted_red"
            app:strokeColor="@color/accent_muted_red"
            app:strokeWidth="1dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenTool"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.8"
            android:layout_marginStart="6dp"
            android:text="Open Tool"
            android:textColor="@color/black"
            app:backgroundTint="@color/accent_primary"
            style="@style/Widget.MaterialComponents.Button" />

    </LinearLayout>

</LinearLayout>
