<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_manga_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Row 1: Status Badge + Title + Remove X -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvResultStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_manga_badge"
            android:fontFamily="@font/times_new_roman_bold"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="NOT COMPLETED"
            android:textColor="#FFFDF8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvResultTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/times_new_roman_bold"
            android:singleLine="true"
            android:text="Manga Title - Chapter 1"
            android:textColor="#292722"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btnRemoveResultTop"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Remove"
            android:src="@drawable/ic_close"
            app:tint="#746D62" />
    </LinearLayout>

    <!-- Row 2: Info (Size & Pages) -->
    <TextView
        android:id="@+id/tvResultInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/times_new_roman_regular"
        android:text="30 pages · 15.4 MB"
        android:textColor="#746D62"
        android:textSize="12sp" />

    <!-- Row 3: Compression Size Slider Layout -->
    <LinearLayout
        android:id="@+id/layoutCompressionSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/times_new_roman_regular"
                android:text="Target Compress Size:"
                android:textColor="#746D62"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTargetSizeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/times_new_roman_bold"
                android:text="20 MB"
                android:textColor="#292722"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekBarTargetSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="90"
            android:progress="10"
            android:progressTint="#292722"
            android:thumbTint="#292722" />
    </LinearLayout>

    <!-- Row 4: 4 Action Buttons (Compress, Save, Open, Remove) -->
    <LinearLayout
        android:id="@+id/layoutActionButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnResultCompress"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_manga_button_dark"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:ellipsize="none"
            android:fontFamily="@font/times_new_roman_bold"
            android:maxLines="1"
            android:paddingHorizontal="2dp"
            android:paddingVertical="0dp"
            android:singleLine="true"
            android:text="COMPRESS"
            android:textColor="#FFFDF8"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnResultSave"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_manga_button_secondary"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:ellipsize="none"
            android:fontFamily="@font/times_new_roman_bold"
            android:maxLines="1"
            android:paddingHorizontal="2dp"
            android:paddingVertical="0dp"
            android:singleLine="true"
            android:text="SAVE"
            android:textColor="#292722"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnResultOpen"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_manga_button_secondary"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:ellipsize="none"
            android:fontFamily="@font/times_new_roman_bold"
            android:maxLines="1"
            android:paddingHorizontal="2dp"
            android:paddingVertical="0dp"
            android:singleLine="true"
            android:text="OPEN"
            android:textColor="#292722"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnResultRemove"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_manga_button_secondary"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:ellipsize="none"
            android:fontFamily="@font/times_new_roman_bold"
            android:maxLines="1"
            android:paddingHorizontal="2dp"
            android:paddingVertical="0dp"
            android:singleLine="true"
            android:text="REMOVE"
            android:textColor="#A83232"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
