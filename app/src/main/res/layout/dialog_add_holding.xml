<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20px">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/times_new_roman_bold"
        android:text="Quantity / Shares"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etHoldingQuantity"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_glass_card_overlay"
        android:fontFamily="@font/times_new_roman_regular"
        android:inputType="numberDecimal"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:autofillHints="quantity" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/times_new_roman_bold"
        android:text="Average Acquisition Cost"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etHoldingCost"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_glass_card_overlay"
        android:fontFamily="@font/times_new_roman_regular"
        android:inputType="numberDecimal"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:autofillHints="cost" />

</LinearLayout>
