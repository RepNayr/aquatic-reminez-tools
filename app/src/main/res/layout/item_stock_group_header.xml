<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_terminal_group_header"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="7dp">

    <!-- GROUP COLOR BAR -->
    <View
        android:id="@+id/viewGroupAccent"
        android:layout_width="3.5dp"
        android:layout_height="14dp"
        android:background="@color/accent_teal" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvGroupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/times_new_roman_bold"
            android:letterSpacing="0.08"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="INDONESIA STOCKS" />

        <TextView
            android:id="@+id/tvGroupExchange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/times_new_roman_regular"
            android:textColor="@color/text_muted"
            android:textSize="9.5sp"
            tools:text="IDX · Indonesia Stock Exchange" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvGroupCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_info_chip"
        android:fontFamily="@font/times_new_roman_bold"
        android:paddingHorizontal="7dp"
        android:paddingVertical="2dp"
        android:textColor="@color/accent_cyan"
        android:textSize="9.5sp"
        tools:text="03 INSTRUMENTS" />
</LinearLayout>
