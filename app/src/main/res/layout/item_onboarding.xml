<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="32dp">

    <!-- LOGO BULAT -->
    <androidx.cardview.widget.CardView
        android:id="@+id/iconContainer"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:layout_marginTop="60dp"
        app:cardCornerRadius="52dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/bg_card"
        app:strokeColor="@color/accent_red"
        app:strokeWidth="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/logo_app"
            android:contentDescription="@string/app_name" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/times_new_roman_regular"
        android:letterSpacing="0.4"
        android:text="SLIDE 1"
        android:textColor="@color/accent_red_dark"
        android:textSize="10sp"
        app:layout_constraintTop_toBottomOf="@id/iconContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvJapanese"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:alpha="0.6"
        android:fontFamily="@font/times_new_roman_regular"
        android:text="安全を守り"
        android:textColor="@color/accent_red"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- JUDUL (CYBER BLAST) -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/cyber_blast"
        app:fontFamily="@font/cyber_blast"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:shadowColor="@color/accent_red_glow"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="24"
        android:text="PROTECTED"
        android:textColor="@color/text_primary"
        android:textSize="32sp"
        app:layout_constraintTop_toBottomOf="@id/tvJapanese"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- SUBJUDUL (CYBER BLAST) -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/cyber_blast"
        app:fontFamily="@font/cyber_blast"
        android:gravity="center"
        android:letterSpacing="0.5"
        android:text="SAFETY FIRST ALWAYS"
        android:textColor="@color/accent_red"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/times_new_roman_regular"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Keamanan tingkat tinggi\nSetiap langkahmu terjaga\nSelalu tenang!"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>