<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutDropdownRow"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="@drawable/bg_dropdown_item_normal"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <FrameLayout
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="10dp">

        <ImageView
            android:id="@+id/ivRowLogo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_asset_crypto_btc" />

        <TextView
            android:id="@+id/tvRowFallback"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_icon_circle"
            android:fontFamily="@font/times_new_roman_bold"
            android:gravity="center"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="BTC" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRowSymbolName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/times_new_roman_bold"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="12.5sp"
            android:textStyle="bold"
            tools:text="BTC — Bitcoin" />

        <TextView
            android:id="@+id/tvRowSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/times_new_roman_regular"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            tools:text="COINGECKO · USD · Crypto" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRowPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/times_new_roman_bold"
            android:textColor="@color/text_primary"
            android:textSize="11.5sp"
            android:textStyle="bold"
            tools:text="$68,450.00" />

        <TextView
            android:id="@+id/tvRowChange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/times_new_roman_bold"
            android:textColor="@color/accent_teal"
            android:textSize="10sp"
            tools:text="+3.45%" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivRowCheck"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_dropdown_selected_check"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
