<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- PROFILE HEADER WITH 16:9 LANDSCAPE BACKGROUND IMAGE -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Background Image -->
            <ImageView
                android:id="@+id/ivDrawerHeaderBg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                android:src="@drawable/sidebar_header_img"
                android:contentDescription="@null"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintDimensionRatio="H,16:9" />

            <!-- Subdued Dark Tint Overlay for text legibility -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="#77090B0F"
                app:layout_constraintTop_toTopOf="@id/ivDrawerHeaderBg"
                app:layout_constraintBottom_toBottomOf="@id/ivDrawerHeaderBg"
                app:layout_constraintStart_toStartOf="@id/ivDrawerHeaderBg"
                app:layout_constraintEnd_toEndOf="@id/ivDrawerHeaderBg" />

            <!-- CENTERED HEADER CONTENT -->
            <LinearLayout
                android:id="@+id/headerContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.cardview.widget.CardView
                    android:id="@+id/drawerLogoCard"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    app:cardCornerRadius="34dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:strokeColor="@color/accent_primary"
                    app:strokeWidth="2dp">

                    <ImageView
                        android:id="@+id/ivDrawerLogo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/logo_app"
                        android:contentDescription="@string/app_name" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvDrawerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/times_new_roman_bold"
                    android:letterSpacing="0.05"
                    android:text="ReePNayr"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDrawerCreated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/times_new_roman_regular"
                    android:text="Created: 11-10-2026"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- QUICK ACCESS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/accent_primary"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/times_new_roman_bold"
                android:letterSpacing="0.1"
                android:text="@string/drawer_quick_access"
                android:textColor="@color/accent_primary"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuHome"
            style="@style/DrawerMenuItem">

            <ImageView
                style="@style/DrawerMenuIcon"
                android:src="@drawable/ic_home"
                android:contentDescription="@string/nav_home"
                app:tint="@color/accent_primary" />

            <TextView
                style="@style/DrawerMenuText"
                android:text="@string/nav_home" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuSearch"
            style="@style/DrawerMenuItem">

            <ImageView
                style="@style/DrawerMenuIcon"
                android:src="@drawable/ic_search"
                android:contentDescription="@string/nav_search"
                app:tint="@color/accent_primary" />

            <TextView
                style="@style/DrawerMenuText"
                android:text="@string/nav_search" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuHistory"
            style="@style/DrawerMenuItem">

            <ImageView
                style="@style/DrawerMenuIcon"
                android:src="@drawable/ic_history"
                android:contentDescription="@string/nav_history"
                app:tint="@color/accent_primary" />

            <TextView
                style="@style/DrawerMenuText"
                android:text="@string/nav_history" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuNews"
            style="@style/DrawerMenuItem">

            <ImageView
                style="@style/DrawerMenuIcon"
                android:src="@drawable/ic_info"
                android:contentDescription="@string/news_title"
                app:tint="@color/accent_primary" />

            <TextView
                style="@style/DrawerMenuText"
                android:text="@string/news_title" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuMarket"
            style="@style/DrawerMenuItem">

            <ImageView
                style="@style/DrawerMenuIcon"
                android:src="@drawable/ic_activity"
                android:contentDescription="@string/market_title"
                app:tint="@color/accent_primary" />

            <TextView
                style="@style/DrawerMenuText"
                android:text="Market Terminal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuFavorites"
            style="@style/DrawerMenuItem">

            <ImageView
                style="@style/DrawerMenuIcon"
                android:src="@drawable/ic_favorite"
                android:contentDescription="@string/drawer_favorites"
                app:tint="@color/accent_primary" />

            <TextView
                style="@style/DrawerMenuText"
                android:text="@string/drawer_favorites" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuCategories"
            style="@style/DrawerMenuItem">

            <ImageView
                style="@style/DrawerMenuIcon"
                android:src="@drawable/ic_categories"
                android:contentDescription="@string/drawer_categories"
                app:tint="@color/accent_primary" />

            <TextView
                style="@style/DrawerMenuText"
                android:text="@string/drawer_categories" />
        </LinearLayout>

        <View style="@style/DrawerDivider" />

        <!-- SOCIAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/accent_primary"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/times_new_roman_bold"
                android:letterSpacing="0.1"
                android:text="@string/drawer_social"
                android:textColor="@color/accent_primary"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuTiktok"
            style="@style/DrawerMenuItem">

            <ImageView
                style="@style/DrawerMenuIcon"
                android:src="@drawable/ic_tiktok"
                android:contentDescription="@string/drawer_tiktok"
                app:tint="@color/accent_primary" />

            <TextView
                style="@style/DrawerMenuText"
                android:text="@string/drawer_tiktok" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuInstagram"
            style="@style/DrawerMenuItem">

            <ImageView
                style="@style/DrawerMenuIcon"
                android:src="@drawable/ic_instagram"
                android:contentDescription="@string/drawer_instagram"
                app:tint="@color/accent_primary" />

            <TextView
                style="@style/DrawerMenuText"
                android:text="@string/drawer_instagram" />
        </LinearLayout>

        <View style="@style/DrawerDivider" />

        <!-- FEATURES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/accent_primary"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/times_new_roman_bold"
                android:letterSpacing="0.1"
                android:text="@string/drawer_features"
                android:textColor="@color/accent_primary"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuGames"
            style="@style/DrawerMenuItem">

            <ImageView
                style="@style/DrawerMenuIcon"
                android:src="@drawable/ic_games"
                android:contentDescription="@string/cat_games"
                app:tint="@color/accent_primary" />

            <TextView
                style="@style/DrawerMenuText"
                android:text="@string/cat_games" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuStorage"
            style="@style/DrawerMenuItem">

            <ImageView
                style="@style/DrawerMenuIcon"
                android:src="@drawable/ic_storage"
                android:contentDescription="@string/drawer_storage"
                app:tint="@color/accent_primary" />

            <TextView
                style="@style/DrawerMenuText"
                android:text="@string/drawer_storage" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuPassword"
            style="@style/DrawerMenuItem">

            <ImageView
                style="@style/DrawerMenuIcon"
                android:src="@drawable/ic_lock"
                android:contentDescription="@string/drawer_create_password"
                app:tint="@color/accent_primary" />

            <TextView
                android:id="@+id/tvPasswordLabel"
                style="@style/DrawerMenuText"
                android:text="@string/drawer_create_password" />
        </LinearLayout>

        <View style="@style/DrawerDivider" />

        <!-- SETTINGS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/accent_primary"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/times_new_roman_bold"
                android:letterSpacing="0.1"
                android:text="@string/drawer_settings_header"
                android:textColor="@color/accent_primary"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuAbout"
            style="@style/DrawerMenuItem">

            <ImageView
                style="@style/DrawerMenuIcon"
                android:src="@drawable/ic_info"
                android:contentDescription="@string/nav_about"
                app:tint="@color/accent_primary" />

            <TextView
                style="@style/DrawerMenuText"
                android:text="@string/nav_about" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuSettings"
            style="@style/DrawerMenuItem">

            <ImageView
                style="@style/DrawerMenuIcon"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/nav_settings"
                app:tint="@color/accent_primary" />

            <TextView
                style="@style/DrawerMenuText"
                android:text="@string/nav_settings" />
        </LinearLayout>

        <!-- FOOTER -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            android:background="@color/divider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/times_new_roman_regular"
            android:gravity="center"
            android:text="Aquatic Reminez Tools • v1.0.0"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="28dp"
            android:fontFamily="@font/times_new_roman_regular"
            android:gravity="center"
            android:text="@string/drawer_copyright"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
