<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_terminal_group_header"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/ivMacroCountryFlag"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        tools:src="@drawable/ic_asset_forex_usdidr" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMacroCountryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/times_new_roman_bold"
            android:letterSpacing="0.08"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="INDONESIA · MACROECONOMIC" />

        <TextView
            android:id="@+id/tvMacroCountrySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/times_new_roman_regular"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            tools:text="Central Bank Policy Rate &amp; Economic Growth" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMacroCountryCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_info_chip"
        android:fontFamily="@font/times_new_roman_bold"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:textColor="@color/accent_cyan"
        android:textSize="9.5sp"
        tools:text="3 INDICATORS" />

</LinearLayout>
