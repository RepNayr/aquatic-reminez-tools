<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootVideoLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3EFE6">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Top Spacer for Window Inset / Status Bar -->
            <View
                android:id="@+id/viewTopSpacer"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <!-- Top Header: Back Arrow + Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_manga_button_secondary"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="#292722" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/times_new_roman_bold"
                    android:text="Private Video Downloader"
                    android:textColor="#292722"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/times_new_roman_regular"
                android:text="Enter HentaiCop series URL to analyze available episodes"
                android:textColor="#746D62"
                android:textSize="14sp" />

            <!-- URL Input Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_manga_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    app:tint="#746D62" />

                <EditText
                    android:id="@+id/etUrlInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/times_new_roman_regular"
                    android:hint="https://hentaicop.com/series/..."
                    android:inputType="textUri"
                    android:textColor="#292722"
                    android:textColorHint="#999184"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/btnPasteUrl"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="2dp"
                    android:src="@drawable/ic_paste"
                    app:tint="#292722" />
            </LinearLayout>

            <!-- Analyze Button -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnAnalyze"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_manga_button_dark"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:fontFamily="@font/times_new_roman_bold"
                    android:text="ANALYZE SERIES"
                    android:textColor="#FFFDF8"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/pbAnalyzeLoading"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="#FFFDF8"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Series Preview Card -->
            <LinearLayout
                android:id="@+id/cardVideoPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_manga_card"
                android:orientation="horizontal"
                android:padding="16dp"
                android:visibility="gone">

                <!-- Cover Image -->
                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="110dp"
                    android:background="#E2DCD0">

                    <ImageView
                        android:id="@+id/ivCoverPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:id="@+id/tvCoverPlaceholder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:text="COVER"
                        android:textColor="#746D62"
                        android:textSize="12sp" />
                </FrameLayout>

                <!-- Series Info -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSeriesTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:maxLines="2"
                        android:text="Series Title"
                        android:textColor="#292722"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSeriesDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/times_new_roman_regular"
                        android:maxLines="3"
                        android:text="Synopsis / Description"
                        android:textColor="#746D62"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Episodes Section Header -->
            <TextView
                android:id="@+id/tvEpisodeHeaderCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/times_new_roman_bold"
                android:text="Episodes"
                android:textColor="#292722"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Episode RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEpisodeList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />

            <!-- Download All Button -->
            <Button
                android:id="@+id/btnDownloadAll"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_manga_button_dark"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:fontFamily="@font/times_new_roman_bold"
                android:text="DOWNLOAD ALL EPISODES"
                android:textColor="#FFFDF8"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Downloaded Results Header & List -->
            <TextView
                android:id="@+id/tvResultsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/times_new_roman_bold"
                android:text="DOWNLOADED RESULTS"
                android:textColor="#292722"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvResultsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="80dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Scrim overlay when popup is open -->
    <View
        android:id="@+id/vPopupScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone" />

    <!-- Floating Downloads Button (Bottom Right) -->
    <FrameLayout
        android:id="@+id/btnFloatingDownload"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_manga_floating_btn"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_download"
            app:tint="#292722" />

        <!-- Queue Badge Counter -->
        <TextView
            android:id="@+id/tvBadgeCounter"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_manga_badge"
            android:fontFamily="@font/times_new_roman_bold"
            android:gravity="center"
            android:text="0"
            android:textColor="#FFFDF8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

</RelativeLayout>
