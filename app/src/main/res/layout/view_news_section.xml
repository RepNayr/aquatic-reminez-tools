<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutNewsSection"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- SECTION HEADER -->
    <LinearLayout
        android:id="@+id/layoutNewsHeaderTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivNewsHeaderIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_info"
            app:tint="@color/accent_primary" />

        <TextView
            android:id="@+id/tvNewsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/times_new_roman_bold"
            android:letterSpacing="0.12"
            android:text="@string/news_title"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNewsSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/times_new_roman_bold"
            android:text="@string/news_desc"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/accent_primary" />

    </LinearLayout>

    <View
        android:id="@+id/sectionLineNews"
        android:layout_width="3dp"
        android:layout_height="14dp"
        android:background="@color/accent_primary"
        app:layout_constraintTop_toTopOf="@id/layoutNewsHeaderTitle"
        app:layout_constraintBottom_toBottomOf="@id/layoutNewsHeaderTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- SINGLE UNIFIED GLASS CARD -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/cardNews"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:background="@drawable/bg_glass_card_clip"
        app:layout_constraintTop_toBottomOf="@id/layoutNewsHeaderTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_glass_card_overlay" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_glass_card_specular" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <!-- LOADING INDICATOR -->
            <ProgressBar
                android:id="@+id/pbNewsLoading"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="16dp"
                android:visibility="gone" />

            <!-- FEATURED ARTICLE CONTAINER -->
            <FrameLayout
                android:id="@+id/containerFeaturedArticle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- COMPACT ARTICLES CONTAINER -->
            <LinearLayout
                android:id="@+id/layoutCompactArticles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- STATUS FOOTER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNewsStatusIndicator"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/times_new_roman_bold"
                    android:textColor="@color/status_warning"
                    android:textSize="9sp"
                    android:visibility="gone"
                    tools:text="Offline Data"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvNewsAttribution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/times_new_roman_bold"
                    android:letterSpacing="0.02"
                    android:text="Aquatic Reminez Tools · News Engine"
                    android:textColor="@color/text_muted"
                    android:textSize="9sp" />

            </LinearLayout>

        </LinearLayout>

    </eightbitlab.com.blurview.BlurView>

</androidx.constraintlayout.widget.ConstraintLayout>
