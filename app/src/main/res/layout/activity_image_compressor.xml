<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090B0F"
    tools:context=".presentation.compressor.ImageCompressorActivity">

    <!-- Main Container -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Header Bar -->
        <RelativeLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignParentTop="true"
            android:background="#151A21"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#E8EAED" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@id/btnBack"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/times_new_roman_bold"
                    android:text="Image Compressor"
                    android:textColor="#E8EAED"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/times_new_roman_regular"
                    android:text="Cyber-grade multi-image optimizer"
                    android:textColor="#9AA0A6"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSessionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_info_chip"
                android:fontFamily="@font/times_new_roman_bold"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="IDLE"
                android:textColor="#43D9E6"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Main Workspace ScrollView -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/topBar"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- SECTION 1: INPUT IMAGES -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#151A21"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="#353941"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/times_new_roman_bold"
                                android:text="1. Input Images"
                                android:textColor="#E8EAED"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvBatchCountSize"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:fontFamily="@font/times_new_roman_regular"
                                android:text="0 / 10 images (0 MB / 200 MB)"
                                android:textColor="#9AA0A6"
                                android:textSize="12sp" />
                        </RelativeLayout>

                        <!-- Import Buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnImportGallery"
                                style="@style/ButtonOutline"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/times_new_roman_bold"
                                android:padding="0dp"
                                android:text="Gallery"
                                android:textColor="#43D9E6"
                                android:textSize="12sp"
                                app:strokeColor="#43D9E6" />

                            <Button
                                android:id="@+id/btnImportFiles"
                                style="@style/ButtonOutline"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="4dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/times_new_roman_bold"
                                android:padding="0dp"
                                android:text="Files"
                                android:textColor="#A78BFA"
                                android:textSize="12sp"
                                app:strokeColor="#A78BFA" />

                            <Button
                                android:id="@+id/btnImportCamera"
                                style="@style/ButtonOutline"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/times_new_roman_bold"
                                android:padding="0dp"
                                android:text="Camera"
                                android:textColor="#38BFA1"
                                android:textSize="12sp"
                                app:strokeColor="#38BFA1" />
                        </LinearLayout>

                        <!-- Empty State for Selected Images -->
                        <TextView
                            android:id="@+id/tvEmptySelected"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:layout_marginTop="12dp"
                            android:background="#090B0F"
                            android:fontFamily="@font/times_new_roman_regular"
                            android:gravity="center"
                            android:text="No images selected.\nTap Gallery, Files, or Camera to add images (Max 10 images, 50MB per file)."
                            android:textColor="#5F6368"
                            android:textSize="12sp" />

                        <!-- Selected Images Grid -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvSelectedImages"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:nestedScrollingEnabled="false"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- SECTION 2: COMPRESSION SETTINGS -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#151A21"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="#353941"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/times_new_roman_bold"
                            android:text="2. Compression Settings"
                            android:textColor="#E8EAED"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <!-- Mode Chips -->
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:scrollbars="none">

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/chipGroupMode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:singleSelection="true">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipModeAuto"
                                    style="@style/Widget.MaterialComponents.Chip.Choice"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checked="true"
                                    android:fontFamily="@font/times_new_roman_bold"
                                    android:text="Automatic"
                                    android:textColor="#E8EAED" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipModeQuality"
                                    style="@style/Widget.MaterialComponents.Chip.Choice"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/times_new_roman_bold"
                                    android:text="Quality Slider"
                                    android:textColor="#E8EAED" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipModeTarget"
                                    style="@style/Widget.MaterialComponents.Chip.Choice"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/times_new_roman_bold"
                                    android:text="Target File Size"
                                    android:textColor="#E8EAED" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipModePreset"
                                    style="@style/Widget.MaterialComponents.Chip.Choice"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/times_new_roman_bold"
                                    android:text="Presets"
                                    android:textColor="#E8EAED" />
                            </com.google.android.material.chip.ChipGroup>
                        </HorizontalScrollView>

                        <!-- Quality Slider Container -->
                        <LinearLayout
                            android:id="@+id/layoutQualitySlider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/times_new_roman_regular"
                                    android:text="Quality:"
                                    android:textColor="#9AA0A6"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvQualityValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:fontFamily="@font/times_new_roman_bold"
                                    android:text="75%"
                                    android:textColor="#43D9E6"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </RelativeLayout>

                            <SeekBar
                                android:id="@+id/seekBarQuality"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:max="90"
                                android:progress="65" />
                        </LinearLayout>

                        <!-- Target File Size Container -->
                        <LinearLayout
                            android:id="@+id/layoutTargetSize"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:fontFamily="@font/times_new_roman_regular"
                                android:text="Target Size:"
                                android:textColor="#9AA0A6"
                                android:textSize="12sp" />

                            <Spinner
                                android:id="@+id/spinnerTargetSize"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_input_field" />
                        </LinearLayout>

                        <!-- Presets Container -->
                        <LinearLayout
                            android:id="@+id/layoutPresets"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:fontFamily="@font/times_new_roman_regular"
                                android:text="Preset:"
                                android:textColor="#9AA0A6"
                                android:textSize="12sp" />

                            <Spinner
                                android:id="@+id/spinnerPreset"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_input_field" />
                        </LinearLayout>

                        <!-- Output Format Spinner -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:fontFamily="@font/times_new_roman_regular"
                                android:text="Output Format:"
                                android:textColor="#9AA0A6"
                                android:textSize="12sp" />

                            <Spinner
                                android:id="@+id/spinnerOutputFormat"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_input_field" />
                        </LinearLayout>

                        <!-- Collapsible Advanced Settings Button -->
                        <TextView
                            android:id="@+id/btnToggleAdvanced"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/times_new_roman_bold"
                            android:text="▶ Advanced Settings (Resize &amp; Metadata)"
                            android:textColor="#43D9E6"
                            android:textSize="12sp" />

                        <!-- Advanced Settings Collapsible Container -->
                        <LinearLayout
                            android:id="@+id/layoutAdvancedSettings"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <CheckBox
                                android:id="@+id/cbEnableResize"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/times_new_roman_regular"
                                android:text="Enable Image Resizing"
                                android:textColor="#E8EAED"
                                android:textSize="12sp" />

                            <LinearLayout
                                android:id="@+id/layoutResizeOptions"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <SeekBar
                                    android:id="@+id/seekBarResizePercent"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:max="90"
                                    android:progress="70" />

                                <TextView
                                    android:id="@+id/tvResizePercentValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/times_new_roman_regular"
                                    android:text="Resize: 80%"
                                    android:textColor="#9AA0A6"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <CheckBox
                                android:id="@+id/cbStripGps"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:fontFamily="@font/times_new_roman_regular"
                                android:text="Strip GPS Location Metadata"
                                android:textColor="#E8EAED"
                                android:textSize="12sp" />

                            <CheckBox
                                android:id="@+id/cbPreserveIcc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:fontFamily="@font/times_new_roman_regular"
                                android:text="Preserve Color Profiles (ICC)"
                                android:textColor="#E8EAED"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- SECTION 3: QUEUE -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#151A21"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="#353941"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/times_new_roman_bold"
                                android:text="3. Queue"
                                android:textColor="#E8EAED"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/btnPauseResume"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/times_new_roman_bold"
                                    android:padding="4dp"
                                    android:text="Pause"
                                    android:textColor="#43D9E6"
                                    android:textSize="12sp"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/btnCancelQueue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:fontFamily="@font/times_new_roman_bold"
                                    android:padding="4dp"
                                    android:text="Cancel All"
                                    android:textColor="#D9535D"
                                    android:textSize="12sp"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/btnClearQueue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:fontFamily="@font/times_new_roman_bold"
                                    android:padding="4dp"
                                    android:text="Clear"
                                    android:textColor="#9AA0A6"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </RelativeLayout>

                        <TextView
                            android:id="@+id/tvEmptyQueue"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/times_new_roman_regular"
                            android:gravity="center"
                            android:text="Queue is empty."
                            android:textColor="#5F6368"
                            android:textSize="12sp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvQueue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:nestedScrollingEnabled="false"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- SECTION 4: START COMPRESSION ACTION BUTTON -->
                <Button
                    android:id="@+id/btnStartCompression"
                    style="@style/ButtonPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="@font/times_new_roman_bold"
                    android:text="START COMPRESSION"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    app:backgroundTint="#38BFA1" />

                <!-- SECTION 5: RESULTS -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardResultsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#151A21"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="#38BFA1"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/times_new_roman_bold"
                                android:text="5. Results &amp; Comparison"
                                android:textColor="#E8EAED"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvBatchSummaryText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:fontFamily="@font/times_new_roman_bold"
                                android:textColor="#38BFA1"
                                android:textSize="12sp" />
                        </RelativeLayout>

                        <!-- Results RecyclerView with Before/After Comparisons -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvResults"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:nestedScrollingEnabled="false" />

                        <!-- Batch Action Buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnSaveAll"
                                style="@style/ButtonPrimary"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/times_new_roman_bold"
                                android:padding="0dp"
                                android:text="Save All"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                app:backgroundTint="#38BFA1" />

                            <Button
                                android:id="@+id/btnShareAll"
                                style="@style/ButtonOutline"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="4dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/times_new_roman_bold"
                                android:padding="0dp"
                                android:text="Share All"
                                android:textColor="#43D9E6"
                                android:textSize="12sp"
                                app:strokeColor="#43D9E6" />

                            <Button
                                android:id="@+id/btnClearResults"
                                style="@style/ButtonOutline"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/times_new_roman_bold"
                                android:padding="0dp"
                                android:text="Discard All"
                                android:textColor="#D9535D"
                                android:textSize="12sp"
                                app:strokeColor="#D9535D" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </RelativeLayout>
</androidx.drawerlayout.widget.DrawerLayout>
