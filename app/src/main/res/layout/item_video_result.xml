<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_manga_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Header: Title + Status Badge + Remove Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvResultTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/times_new_roman_bold"
            android:maxLines="2"
            android:text="Episode 1 · Hitori Tsuma"
            android:textColor="#292722"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvResultStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_manga_badge"
            android:fontFamily="@font/times_new_roman_bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="COMPLETED"
            android:textColor="#FFFDF8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnRemoveResultTop"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="2dp"
            android:src="@drawable/ic_close"
            app:tint="#746D62" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvResultInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/times_new_roman_regular"
        android:text="720p MP4 · 154.7 MB"
        android:textColor="#746D62"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="#E2DCD0" />

    <!-- Compression Controls (Target Size Slider) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/times_new_roman_bold"
            android:text="Target Size:"
            android:textColor="#292722"
            android:textSize="13sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seekBarTargetSize"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="490"
            android:progress="90"
            android:progressTint="#292722"
            android:thumbTint="#292722" />

        <TextView
            android:id="@+id/tvTargetSizeLabel"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/times_new_roman_bold"
            android:gravity="end"
            android:text="100 MB"
            android:textColor="#292722"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnResultPlay"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_manga_button_dark"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:fontFamily="@font/times_new_roman_bold"
            android:text="PLAY"
            android:textColor="#FFFDF8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnResultCompress"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_manga_button_secondary"
            android:fontFamily="@font/times_new_roman_bold"
            android:text="COMPRESS"
            android:textColor="#292722"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnResultSave"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_manga_button_secondary"
            android:fontFamily="@font/times_new_roman_bold"
            android:text="SAVE"
            android:textColor="#292722"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnResultRemove"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_manga_button_secondary"
            android:fontFamily="@font/times_new_roman_bold"
            android:text="REMOVE"
            android:textColor="#D32F2F"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
