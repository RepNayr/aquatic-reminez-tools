<?xml version="1.0" encoding="utf-8"?>
<eightbitlab.com.blurview.BlurView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/blurKeyMarketCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/bg_glass_card_clip">

    <!-- OVERLAY LAYERS -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_glass_card_overlay" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_glass_card_specular" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- TOP ROW: LOGO, SYMBOL, NAME, STATUS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_icon_circle">

                <ImageView
                    android:id="@+id/ivKeyLogo"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:contentDescription="Asset Logo"
                    tools:src="@drawable/ic_activity" />

                <TextView
                    android:id="@+id/tvKeyFallback"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/times_new_roman_bold"
                    android:textColor="@color/text_primary"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="BTC" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvKeySymbol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:textColor="@color/accent_blue"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="BTC" />

                    <TextView
                        android:id="@+id/tvKeyCountry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/times_new_roman_regular"
                        android:textColor="@color/text_muted"
                        android:textSize="9.5sp"
                        tools:text="US" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvKeyName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/times_new_roman_regular"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    tools:text="Bitcoin" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvKeyStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_info_chip"
                android:fontFamily="@font/times_new_roman_bold"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp"
                android:textColor="@color/accent_cyan"
                android:textSize="8.5sp"
                tools:text="LIVE" />
        </LinearLayout>

        <!-- SPARKLINE MINI-CHART -->
        <com.repp.aquaticremineztools.presentation.home.SparklineView
            android:id="@+id/sparklineKey"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- PRICE AND CHANGE ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvKeyPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/times_new_roman_bold"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold"
                tools:text="$68,450.00" />

            <TextView
                android:id="@+id/tvKeyChange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/times_new_roman_bold"
                android:textColor="@color/accent_teal"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="+2.34%" />
        </LinearLayout>

    </LinearLayout>

</eightbitlab.com.blurview.BlurView>
