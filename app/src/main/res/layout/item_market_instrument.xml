<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <!-- INSTRUMENT LOGO / BADGE -->
    <FrameLayout
        android:id="@+id/flInstrumentIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_circle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/ivInstrumentLogo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            tools:src="@drawable/ic_activity" />

        <TextView
            android:id="@+id/tvInstrumentFallback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/times_new_roman_bold"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="IHSG" />

    </FrameLayout>

    <!-- NAME, SYMBOL & EXCHANGE -->
    <LinearLayout
        android:id="@+id/layoutInstrumentInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/flInstrumentIcon"
        app:layout_constraintEnd_toStartOf="@id/layoutInstrumentPrice"
        app:layout_constraintHorizontal_weight="1">

        <TextView
            android:id="@+id/tvInstrumentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/times_new_roman_bold"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold"
            tools:text="Jakarta Composite Index" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvInstrumentSymbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/times_new_roman_bold"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                tools:text="IHSG" />

            <View
                android:layout_width="3dp"
                android:layout_height="3dp"
                android:layout_marginHorizontal="6dp"
                android:background="@color/text_muted" />

            <TextView
                android:id="@+id/tvInstrumentExchange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/times_new_roman_regular"
                android:textColor="@color/text_muted"
                android:textSize="10.5sp"
                tools:text="IDX" />

        </LinearLayout>

    </LinearLayout>

    <!-- PRICE & CHANGE -->
    <LinearLayout
        android:id="@+id/layoutInstrumentPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvInstrumentPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/times_new_roman_bold"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold"
            tools:text="$7,324.50" />

        <TextView
            android:id="@+id/tvInstrumentChange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/times_new_roman_bold"
            android:textColor="@color/accent_teal"
            android:textSize="11.5sp"
            android:textStyle="bold"
            tools:text="+0.62%" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
