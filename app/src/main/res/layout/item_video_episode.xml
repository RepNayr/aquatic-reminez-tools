<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootEpisodeLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_manga_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Episode Thumbnail (Left) -->
    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="64dp"
        android:background="#E2DCD0">

        <ImageView
            android:id="@+id/ivEpisodeThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tvThumbnailPlaceholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/times_new_roman_bold"
            android:text="VIDEO"
            android:textColor="#746D62"
            android:textSize="12sp" />
    </FrameLayout>

    <!-- Title, Duration & Config Status (Center) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvEpisodeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/times_new_roman_bold"
            android:maxLines="2"
            android:text="Episode 1"
            android:textColor="#292722"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEpisodeDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/times_new_roman_regular"
            android:text="Duration: 23:36"
            android:textColor="#746D62"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvEpisodeConfigStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/times_new_roman_bold"
            android:text="720p HD • Ready"
            android:textColor="#2E7D32"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Download Button (Right) -->
    <Button
        android:id="@+id/btnDownloadEpisode"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_manga_button_dark"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:fontFamily="@font/times_new_roman_bold"
        android:paddingHorizontal="12dp"
        android:text="DOWNLOAD"
        android:textColor="#FFFDF8"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
