<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardFileItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/bg_card"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- THUMBNAIL -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0"
            app:layout_constraintDimensionRatio="1:1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@color/bg_secondary">

                <ImageView
                    android:id="@+id/ivFileThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_file_other"
                    android:contentDescription="@string/storage_empty_title" />

                <ImageView
                    android:id="@+id/ivFileTypeIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_file_image"
                    android:visibility="gone"
                    app:tint="@color/accent_red" />

                <!-- OVERLAY SELECTED -->
                <View
                    android:id="@+id/selectedOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#AAFF1A1A"
                    android:visibility="gone" />

                <!-- CHECK ICON -->
                <ImageView
                    android:id="@+id/ivSelectedCheck"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_check_circle"
                    android:padding="4dp"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    app:tint="@color/white" />

            </FrameLayout>

        </FrameLayout>

        <!-- INFO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:fontFamily="@font/times_new_roman_bold"
                android:maxLines="1"
                android:text="file.jpg"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvFileSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/times_new_roman_regular"
                android:text="1.2 MB"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>