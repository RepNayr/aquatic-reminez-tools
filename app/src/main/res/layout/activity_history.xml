<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".presentation.history.HistoryActivity">

    <!-- KONTEN UTAMA -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_primary"
        android:fitsSystemWindows="true">

        <!-- BACKGROUND IMAGE LAYER WITH BLUR TARGET -->
        <eightbitlab.com.blurview.BlurTarget
            android:id="@+id/homeBlurTarget"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ivHomeBackground"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/home_background_image"
                android:alpha="0.38"
                android:contentDescription="@null" />

        </eightbitlab.com.blurview.BlurTarget>

        <!-- GRADIENT OVERLAY -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_home_overlay" />

        <!-- APP BAR / TOOLBAR -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#080808"
            android:fitsSystemWindows="true"
            app:elevation="4dp">

            <!-- NORMAL TOOLBAR -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/normalToolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <FrameLayout
                    android:id="@+id/btnMenu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_menu"
                        android:contentDescription="@string/menu"
                        app:tint="@color/accent_primary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/times_new_roman_bold"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:text="@string/nav_history"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/btnMenu"
                    app:layout_constraintEnd_toStartOf="@id/btnMoreOptions" />

                <FrameLayout
                    android:id="@+id/btnMoreOptions"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_more_vert"
                        android:contentDescription="@string/more_options"
                        app:tint="@color/accent_primary" />
                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- SELECTION TOOLBAR -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/selectionToolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="36dp"
                android:paddingBottom="12dp"
                android:visibility="gone"
                android:background="#12151A">

                <FrameLayout
                    android:id="@+id/btnCloseSelection"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_close"
                        android:contentDescription="@null"
                        app:tint="@color/text_primary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvSelectionCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/times_new_roman_bold"
                    android:text="0 selected"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/btnCloseSelection"
                    app:layout_constraintEnd_toStartOf="@id/btnSelectAll" />

                <TextView
                    android:id="@+id/btnSelectAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:fontFamily="@font/times_new_roman_bold"
                    android:text="Select All"
                    android:textColor="@color/accent_primary"
                    android:textSize="12sp"
                    android:padding="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnDeleteSelected" />

                <FrameLayout
                    android:id="@+id/btnDeleteSelected"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_delete"
                        android:contentDescription="@null"
                        app:tint="@color/accent_muted_red" />
                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.appbar.AppBarLayout>

        <!-- SCROLLABLE CONTENT -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="70dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingTop="12dp">

                <!-- INTRO BANNER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvIntroTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/times_new_roman_bold"
                            android:text="Your recent activity"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvIntroSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/times_new_roman_regular"
                            android:text="Stored on this device · Auto-deleted after 30 days."
                            android:textColor="@color/text_muted"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRecordCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_info_chip"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:textColor="@color/accent_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="8 records" />
                </LinearLayout>

                <!-- SEARCH BAR -->
                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/blurSearchBar"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_glass_card_clip">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_glass_card_overlay" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_search"
                            app:tint="@color/text_secondary"
                            android:contentDescription="@null" />

                        <EditText
                            android:id="@+id/etSearch"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:background="@null"
                            android:fontFamily="@font/times_new_roman_regular"
                            android:hint="Search tool name..."
                            android:textColorHint="@color/text_muted"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:singleLine="true" />

                        <ImageView
                            android:id="@+id/btnClearSearch"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_close"
                            app:tint="@color/text_secondary"
                            android:visibility="gone"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="@null" />
                    </LinearLayout>
                </eightbitlab.com.blurview.BlurView>

                <!-- FILTER & SORT CONTROLS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <!-- FILTER BUTTON -->
                    <LinearLayout
                        android:id="@+id/btnFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_info_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_filter"
                            app:tint="@color/text_primary"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/times_new_roman_bold"
                            android:text="Filter"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvFilterBadge"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_quick_icon_circle"
                            android:gravity="center"
                            android:fontFamily="@font/times_new_roman_bold"
                            android:textColor="@color/black"
                            android:textSize="9.5sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:text="2" />
                    </LinearLayout>

                    <!-- SORT BUTTON -->
                    <LinearLayout
                        android:id="@+id/btnSort"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_info_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_sort"
                            app:tint="@color/text_primary"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tvSortLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/times_new_roman_bold"
                            android:text="Newest first"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- CLEAR ALL FILTERS -->
                    <TextView
                        android:id="@+id/tvClearAllFilters"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:text="Clear all"
                        android:textColor="@color/accent_primary"
                        android:textSize="11sp"
                        android:padding="6dp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- ACTIVE FILTERS CHIP CONTAINER -->
                <HorizontalScrollView
                    android:id="@+id/svActiveFilters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/cgActiveFilters"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true">
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <!-- LOADING INDICATOR -->
                <ProgressBar
                    android:id="@+id/loadingView"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="24dp"
                    android:visibility="gone" />

                <!-- TIMELINE RECYCLER VIEW -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvHistoryTimeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:nestedScrollingEnabled="false" />

                <!-- EMPTY STATE (NO HISTORY) -->
                <LinearLayout
                    android:id="@+id/emptyStateContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="48dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_history"
                        app:tint="@color/text_muted"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:text="No activity yet"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/times_new_roman_regular"
                        android:text="Tools you open or run will appear here."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- NO RESULTS STATE (SEARCH/FILTER EMPTY) -->
                <LinearLayout
                    android:id="@+id/noResultsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="48dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/text_muted"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:text="No matching activity"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/times_new_roman_regular"
                        android:text="Try another tool name or adjust your filters."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:gravity="center" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetNoResults"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginTop="14dp"
                        android:text="Reset Filters"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/border"
                        app:strokeWidth="1dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- BOTTOM NAV — PILL -->
        <FrameLayout
            android:id="@+id/bottomNavContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:paddingHorizontal="8dp"
            android:paddingBottom="6dp">

            <include
                android:id="@+id/bottomNavPillInclude"
                layout="@layout/view_bottom_nav_pill"
                android:layout_width="match_parent"
                android:layout_height="56dp" />

        </FrameLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- DRAWER -->
    <include
        android:id="@+id/drawerContent"
        layout="@layout/view_drawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
