<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3EFE6"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Top Header -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_manga_button_secondary"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                app:tint="#292722" />
        </FrameLayout>
    </FrameLayout>

    <Spacer
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Lock Icon & Title -->
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_lock"
        app:tint="#292722" />

    <TextView
        android:id="@+id/tvPinTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/times_new_roman_bold"
        android:text="ENTER SECURITY PIN"
        android:textColor="#292722"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPinSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/times_new_roman_regular"
        android:text="Enter 6-digit PIN to access Private Manga Downloader"
        android:textColor="#746D62"
        android:textSize="14sp" />

    <!-- 6 PIN Indicator Dots -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/dot1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="6dp"
            android:background="@drawable/bg_manga_pin_dot_off" />

        <View
            android:id="@+id/dot2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="6dp"
            android:background="@drawable/bg_manga_pin_dot_off" />

        <View
            android:id="@+id/dot3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="6dp"
            android:background="@drawable/bg_manga_pin_dot_off" />

        <View
            android:id="@+id/dot4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="6dp"
            android:background="@drawable/bg_manga_pin_dot_off" />

        <View
            android:id="@+id/dot5"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="6dp"
            android:background="@drawable/bg_manga_pin_dot_off" />

        <View
            android:id="@+id/dot6"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="6dp"
            android:background="@drawable/bg_manga_pin_dot_off" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPinError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/times_new_roman_regular"
        android:textColor="#D9535D"
        android:textSize="13sp"
        android:visibility="invisible" />

    <Spacer
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Numeric Keypad Grid -->
    <GridLayout
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:columnCount="3"
        android:rowCount="4">

        <Button
            android:id="@+id/btnKey1"
            style="@style/MangaKeypadButtonStyle"
            android:text="1" />

        <Button
            android:id="@+id/btnKey2"
            style="@style/MangaKeypadButtonStyle"
            android:text="2" />

        <Button
            android:id="@+id/btnKey3"
            style="@style/MangaKeypadButtonStyle"
            android:text="3" />

        <Button
            android:id="@+id/btnKey4"
            style="@style/MangaKeypadButtonStyle"
            android:text="4" />

        <Button
            android:id="@+id/btnKey5"
            style="@style/MangaKeypadButtonStyle"
            android:text="5" />

        <Button
            android:id="@+id/btnKey6"
            style="@style/MangaKeypadButtonStyle"
            android:text="6" />

        <Button
            android:id="@+id/btnKey7"
            style="@style/MangaKeypadButtonStyle"
            android:text="7" />

        <Button
            android:id="@+id/btnKey8"
            style="@style/MangaKeypadButtonStyle"
            android:text="8" />

        <Button
            android:id="@+id/btnKey9"
            style="@style/MangaKeypadButtonStyle"
            android:text="9" />

        <Button
            android:id="@+id/btnKeyClear"
            style="@style/MangaKeypadButtonStyle"
            android:text="C"
            android:textColor="#746D62"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnKey0"
            style="@style/MangaKeypadButtonStyle"
            android:text="0" />

        <Button
            android:id="@+id/btnKeyDelete"
            style="@style/MangaKeypadButtonStyle"
            android:text="⌫"
            android:textColor="#746D62"
            android:textSize="18sp" />

    </GridLayout>

</LinearLayout>
