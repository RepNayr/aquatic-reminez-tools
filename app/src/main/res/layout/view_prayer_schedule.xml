<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- SECTION HEADER -->
    <View
        android:id="@+id/sectionLinePrayer"
        android:layout_width="3dp"
        android:layout_height="14dp"
        android:background="@color/accent_primary"
        app:layout_constraintTop_toTopOf="@id/tvPrayerTitle"
        app:layout_constraintBottom_toBottomOf="@id/tvPrayerTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvPrayerTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/times_new_roman_bold"
        android:letterSpacing="0.12"
        android:text="@string/prayer_title"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/sectionLinePrayer"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- GLASS CARD -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/cardPrayerSchedule"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_glass_card_clip"
        app:layout_constraintTop_toBottomOf="@id/tvPrayerTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_glass_card_overlay" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_glass_card_specular" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:baselineAligned="false"
            android:paddingHorizontal="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- 5 EVENLY DISTRIBUTED COLUMNS (Tighter spacing) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:weightSum="5">

                <!-- 1. IMSAK -->
                <LinearLayout
                    android:id="@+id/colImsak"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivImsakIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/prayer_imsak"
                        android:src="@drawable/ic_prayer_imsak"
                        app:tint="@color/accent_yellow" />

                    <TextView
                        android:id="@+id/tvImsakLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:text="@string/prayer_imsak"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvImsakTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:text="04:51"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 2. SUBUH -->
                <LinearLayout
                    android:id="@+id/colSubuh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivSubuhIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/prayer_subuh"
                        android:src="@drawable/ic_prayer_subuh"
                        app:tint="@color/accent_yellow" />

                    <TextView
                        android:id="@+id/tvSubuhLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:text="@string/prayer_subuh"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvSubuhTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:text="05:01"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 3. DZUHUR -->
                <LinearLayout
                    android:id="@+id/colDzuhur"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivDzuhurIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/prayer_dzuhur"
                        android:src="@drawable/ic_prayer_dzuhur"
                        app:tint="@color/accent_yellow" />

                    <TextView
                        android:id="@+id/tvDzuhurLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:text="@string/prayer_dzuhur"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvDzuhurTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:text="11:56"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 4. ASHAR -->
                <LinearLayout
                    android:id="@+id/colAshar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivAsharIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/prayer_ashar"
                        android:src="@drawable/ic_prayer_ashar"
                        app:tint="@color/accent_yellow" />

                    <TextView
                        android:id="@+id/tvAsharLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:text="@string/prayer_ashar"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvAsharTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:text="15:18"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 5. MAGHRIB -->
                <LinearLayout
                    android:id="@+id/colMaghrib"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivMaghribIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/prayer_maghrib"
                        android:src="@drawable/ic_prayer_maghrib"
                        app:tint="@color/accent_yellow" />

                    <TextView
                        android:id="@+id/tvMaghribLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:text="@string/prayer_maghrib"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvMaghribTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:text="17:55"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- DIVIDER LINE -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="6dp"
                android:background="#1AFFFFFF" />

            <!-- WAKTU SHOLAT SEKARANG & SHOLAT BERIKUTNYA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="2dp">

                <!-- Waktu sholat sekarang -->
                <TextView
                    android:id="@+id/tvCurrentPrayer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/times_new_roman_bold"
                    android:text="Waktu sholat sekarang: Isya"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <!-- Sholat berikutnya + Countdown (Yellow time) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvNextPrayer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:maxLines="1"
                        android:text="Sholat berikutnya: Shubuh"
                        android:textColor="@color/accent_gold"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:text="01:24:35"
                        android:textColor="@color/accent_yellow"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- OFFLINE / STATUS INDICATOR -->
            <TextView
                android:id="@+id/tvPrayerStatusIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:fontFamily="@font/times_new_roman_bold"
                android:text="Data Offline"
                android:textColor="@color/status_warning"
                android:textSize="9sp"
                android:visibility="gone" />

        </LinearLayout>

    </eightbitlab.com.blurview.BlurView>

</androidx.constraintlayout.widget.ConstraintLayout>
