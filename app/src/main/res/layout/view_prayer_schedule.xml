<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- SECTION HEADER -->
    <LinearLayout
        android:id="@+id/layoutPrayerHeaderTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivPrayerHeaderIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_prayer_header"
            app:tint="@color/accent_cyan" />

        <TextView
            android:id="@+id/tvPrayerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/times_new_roman_bold"
            android:letterSpacing="0.12"
            android:text="@string/prayer_title"
            android:textColor="@color/text_primary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPrayerSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:fontFamily="@font/times_new_roman_bold"
            android:text="ACCURATE TIMES · QIBLA &amp; ADHAN"
            android:textColor="@color/accent_cyan"
            android:textSize="10.5sp" />

        <FrameLayout
            android:id="@+id/btnPrayerRefresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="Refresh Prayer"
                android:src="@drawable/ic_refresh"
                app:tint="@color/accent_cyan" />
        </FrameLayout>

    </LinearLayout>

    <View
        android:id="@+id/sectionLinePrayer"
        android:layout_width="3dp"
        android:layout_height="16dp"
        android:background="@color/accent_cyan"
        app:layout_constraintTop_toTopOf="@id/layoutPrayerHeaderTitle"
        app:layout_constraintBottom_toBottomOf="@id/layoutPrayerHeaderTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvPrayerSummary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="11dp"
        android:fontFamily="@font/times_new_roman_regular"
        android:text="Precise daily prayer schedule calculated according to local coordinates."
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        app:layout_constraintTop_toBottomOf="@id/layoutPrayerHeaderTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- GLASS CARD (UNIFIED SINGLE CARD) -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/cardPrayerSchedule"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:background="@drawable/bg_prayer_card_clip"
        app:layout_constraintTop_toBottomOf="@id/tvPrayerSummary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_prayer_card_overlay" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_prayer_card_specular" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:baselineAligned="false"
            android:paddingHorizontal="14dp"
            android:paddingTop="16dp"
            android:paddingBottom="14dp">

            <!-- 5 EVENLY DISTRIBUTED COLUMNS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:weightSum="5">

                <!-- 1. IMSAK -->
                <LinearLayout
                    android:id="@+id/colImsak"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivImsakIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/prayer_imsak"
                        android:src="@drawable/ic_prayer_imsak"
                        app:tint="@color/accent_cyan" />

                    <TextView
                        android:id="@+id/tvImsakLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:text="@string/prayer_imsak"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvImsakTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:text="04:51"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 2. SUBUH -->
                <LinearLayout
                    android:id="@+id/colSubuh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivSubuhIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/prayer_subuh"
                        android:src="@drawable/ic_prayer_subuh"
                        app:tint="@color/accent_cyan" />

                    <TextView
                        android:id="@+id/tvSubuhLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:text="@string/prayer_subuh"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvSubuhTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:text="05:01"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 3. DZUHUR -->
                <LinearLayout
                    android:id="@+id/colDzuhur"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivDzuhurIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/prayer_dzuhur"
                        android:src="@drawable/ic_prayer_dzuhur"
                        app:tint="@color/accent_cyan" />

                    <TextView
                        android:id="@+id/tvDzuhurLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:text="@string/prayer_dzuhur"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvDzuhurTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:text="11:56"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 4. ASHAR -->
                <LinearLayout
                    android:id="@+id/colAshar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivAsharIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/prayer_ashar"
                        android:src="@drawable/ic_prayer_ashar"
                        app:tint="@color/accent_cyan" />

                    <TextView
                        android:id="@+id/tvAsharLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:text="@string/prayer_ashar"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvAsharTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:text="15:18"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 5. MAGHRIB -->
                <LinearLayout
                    android:id="@+id/colMaghrib"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivMaghribIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/prayer_maghrib"
                        android:src="@drawable/ic_prayer_maghrib"
                        app:tint="@color/accent_cyan" />

                    <TextView
                        android:id="@+id/tvMaghribLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:text="@string/prayer_maghrib"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvMaghribTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:text="17:55"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- SUBTLE 1DP DIVIDER LINE -->
            <View
                android:id="@+id/dividerPrayer"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="#1AFFFFFF" />

            <!-- CURRENT PRAYER & COUNTDOWN PANEL -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutCountdownPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp">

                <!-- ICON TILE -->
                <FrameLayout
                    android:id="@+id/cardCurrentPrayerIcon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_prayer_icon_tile"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <ImageView
                        android:id="@+id/ivCurrentPrayerIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_prayer_maghrib"
                        android:contentDescription="@string/prayer_current_icon_desc"
                        app:tint="@color/accent_cyan" />

                </FrameLayout>

                <!-- CURRENT PRAYER INFO -->
                <LinearLayout
                    android:id="@+id/layoutCurrentPrayerInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toTopOf="@id/cardCurrentPrayerIcon"
                    app:layout_constraintBottom_toBottomOf="@id/cardCurrentPrayerIcon"
                    app:layout_constraintStart_toEndOf="@id/cardCurrentPrayerIcon"
                    app:layout_constraintEnd_toStartOf="@id/layoutNextPrayerInfo">

                    <TextView
                        android:id="@+id/tvCurrentPrayerHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:letterSpacing="0.05"
                        android:text="@string/prayer_ongoing_header"
                        android:textColor="@color/accent_cyan"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCurrentPrayer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:text="@string/prayer_maghrib"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- NEXT PRAYER & COUNTDOWN INFO -->
                <LinearLayout
                    android:id="@+id/layoutNextPrayerInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical"
                    app:layout_constraintTop_toTopOf="@id/cardCurrentPrayerIcon"
                    app:layout_constraintBottom_toBottomOf="@id/cardCurrentPrayerIcon"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/tvCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:text="00:00:00"
                        android:textColor="@color/accent_cyan"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNextPrayer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:letterSpacing="0.05"
                        android:text="MENUJU -"
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- PROGRESS BAR -->
                <ProgressBar
                    android:id="@+id/pbPrayerProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="12dp"
                    android:max="1000"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_prayer_progress"
                    app:layout_constraintTop_toBottomOf="@id/cardCurrentPrayerIcon"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- STATUS INDICATOR -->
                <TextView
                    android:id="@+id/tvPrayerStatusIndicator"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:fontFamily="@font/times_new_roman_bold"
                    android:text="Data Offline"
                    android:textColor="@color/status_warning"
                    android:textSize="9sp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/pbPrayerProgress"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </eightbitlab.com.blurview.BlurView>

</androidx.constraintlayout.widget.ConstraintLayout>
