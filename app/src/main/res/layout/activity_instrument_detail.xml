<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- TOOLBAR -->
    <LinearLayout
        android:id="@+id/layoutDetailToolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_activity"
            app:tint="@color/accent_primary"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDetailSymbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/times_new_roman_bold"
                android:letterSpacing="0.08"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="BTC/USD" />

            <TextView
                android:id="@+id/tvDetailName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/times_new_roman_regular"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                tools:text="Bitcoin" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btnWatchlistToggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_favorite"
            app:tint="@color/accent_primary"
            android:contentDescription="Watchlist" />

    </LinearLayout>

    <!-- SCROLLABLE DETAIL CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/layoutDetailToolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- PRICE HEADER CARD -->
            <eightbitlab.com.blurview.BlurView
                android:id="@+id/cardPriceHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card_clip">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_glass_card_overlay" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvDetailCurrentPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:textColor="@color/text_primary"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="$96,432.50" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvDetailChange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/times_new_roman_bold"
                            android:textColor="@color/accent_teal"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="+3.24% (+$3,024.10)" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvDetailSourceStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/times_new_roman_regular"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            tools:text="Live · CoinGecko" />

                    </LinearLayout>

                </LinearLayout>
            </eightbitlab.com.blurview.BlurView>

            <!-- INTERACTIVE CHART CARD -->
            <eightbitlab.com.blurview.BlurView
                android:id="@+id/cardChartContainer"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_glass_card_clip">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_glass_card_overlay" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- TIMEFRAME SELECTOR -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnTf1d"
                            style="@style/Widget.AppCompat.Button.Borderless"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:fontFamily="@font/times_new_roman_bold"
                            android:text="1D"
                            android:textColor="@color/accent_primary"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnTf1w"
                            style="@style/Widget.AppCompat.Button.Borderless"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:fontFamily="@font/times_new_roman_bold"
                            android:text="1W"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnTf1m"
                            style="@style/Widget.AppCompat.Button.Borderless"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:fontFamily="@font/times_new_roman_bold"
                            android:text="1M"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnTfYtd"
                            style="@style/Widget.AppCompat.Button.Borderless"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:fontFamily="@font/times_new_roman_bold"
                            android:text="1Y"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/btnToggleIndicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:fontFamily="@font/times_new_roman_bold"
                            android:padding="6dp"
                            android:text="SMA: ON"
                            android:textColor="@color/accent_teal"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <!-- MPANDROIDCHART LINE/CANDLESTICK -->
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chartInstrument"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginTop="8dp" />

                </LinearLayout>
            </eightbitlab.com.blurview.BlurView>

            <!-- PORTFOLIO / ACTION BUTTON -->
            <Button
                android:id="@+id/btnAddPortfolio"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/accent_primary"
                android:fontFamily="@font/times_new_roman_bold"
                android:text="Add to Portfolio Holdings"
                android:textColor="@color/bg_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
