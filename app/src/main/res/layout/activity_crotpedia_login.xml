<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLoginLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3EFE6"
    android:orientation="vertical">

    <!-- Top Spacer for Window Inset / Status Bar -->
    <View
        android:id="@+id/viewLoginTopSpacer"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <!-- Top Header: Back Arrow + Title + Retry Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <FrameLayout
            android:id="@+id/btnLoginBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_manga_button_secondary"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                app:tint="#292722" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:fontFamily="@font/times_new_roman_bold"
            android:text="Login CrotPedia"
            android:textColor="#292722"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Small Retry Button -->
        <Button
            android:id="@+id/btnWebViewRetry"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_manga_button_secondary"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:fontFamily="@font/times_new_roman_bold"
            android:paddingHorizontal="12dp"
            android:text="RETRY"
            android:textColor="#292722"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/pbWebViewLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="#292722" />

    <!-- WebView Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webViewCrotPedia"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Verifying Overlay / Status -->
        <LinearLayout
            android:id="@+id/layoutVerifying"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B3F3EFE6"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="#292722" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/times_new_roman_bold"
                android:text="Memverifikasi Sesi Login..."
                android:textColor="#292722"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
