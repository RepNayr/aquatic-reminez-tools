<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- SECTION HEADER -->
    <View
        android:id="@+id/sectionLine"
        android:layout_width="3dp"
        android:layout_height="14dp"
        android:background="@color/accent_primary"
        app:layout_constraintTop_toTopOf="@id/tvQuickMenuTitle"
        app:layout_constraintBottom_toBottomOf="@id/tvQuickMenuTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvQuickMenuTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/times_new_roman_bold"
        android:letterSpacing="0.12"
        android:text="@string/home_quick_menu"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/sectionLine"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- GRID -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvQuickMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:nestedScrollingEnabled="false"
        app:layout_constraintTop_toBottomOf="@id/tvQuickMenuTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
