<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_glass_card_clip"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="11dp">

    <TextView
        android:id="@+id/tvStockTickerBadge"
        android:layout_width="48dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_info_chip"
        android:fontFamily="@font/times_new_roman_bold"
        android:gravity="center"
        android:textColor="@color/accent_teal"
        android:textSize="12.5sp"
        android:textStyle="bold"
        tools:text="BBCA" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStockName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/times_new_roman_bold"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold"
            tools:text="Bank Central Asia Tbk" />

        <TextView
            android:id="@+id/tvStockExchange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/times_new_roman_regular"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            tools:text="IDX · Indonesia" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStockPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/times_new_roman_bold"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold"
            tools:text="Rp 10,250" />

        <TextView
            android:id="@+id/tvStockChange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/times_new_roman_bold"
            android:textColor="@color/accent_teal"
            android:textSize="11.5sp"
            android:textStyle="bold"
            tools:text="+1.20%" />
    </LinearLayout>

</LinearLayout>
