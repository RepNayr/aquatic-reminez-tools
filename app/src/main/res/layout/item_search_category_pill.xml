<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCategoryPill"
    android:layout_width="wrap_content"
    android:layout_height="38dp"
    android:layout_marginEnd="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="19dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/transparent"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurCategoryPill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_glass_card_clip">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_glass_card_overlay"
            android:clickable="false"
            android:focusable="false" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/ivCatIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_utility"
                app:tint="@color/text_primary"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvCatName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/times_new_roman_bold"
                android:text="Utility"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                tools:text="Utility" />

        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

</com.google.android.material.card.MaterialCardView>
