<?xml version="1.0" encoding="utf-8"?>
<com.repp.aquaticremineztools.presentation.home.SquareCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCategory"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/transparent"
    app:strokeColor="@color/transparent"
    app:strokeWidth="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_glass_card_clip">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_glass_card_overlay"
            android:clickable="false"
            android:focusable="false" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_glass_card_specular"
            android:clickable="false"
            android:focusable="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="4dp"
            android:paddingHorizontal="2dp">

            <!-- ICON CONTAINER -->
            <FrameLayout
                android:id="@+id/iconContainer"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_quick_icon_circle">

                <ImageView
                    android:id="@+id/ivIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_utility"
                    android:contentDescription="@string/cat_utility"
                    app:tint="@color/cat_utility" />

            </FrameLayout>

            <!-- NAME -->
            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/times_new_roman_bold"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="1dp"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="Utility" />

            <!-- COUNT (Optional) -->
            <TextView
                android:id="@+id/tvCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/times_new_roman_regular"
                android:gravity="center"
                android:textColor="@color/text_muted"
                android:textSize="9sp"
                android:visibility="gone"
                tools:text="8 tools" />

        </LinearLayout>

    </FrameLayout>

</com.repp.aquaticremineztools.presentation.home.SquareCardView>