<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="330dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_manga_popup"
    android:elevation="12dp"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header: Icon + Downloads + Status Badge + Close X -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_cloud_download"
            app:tint="#292722" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/times_new_roman_bold"
            android:text="Downloads"
            android:textColor="#292722"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPopupStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_manga_button_secondary"
            android:fontFamily="@font/times_new_roman_bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="1 ACTIVE"
            android:textColor="#292722"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnPopupClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_close"
            app:tint="#292722" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="#E5E3DF" />

    <!-- Tabs Header: Active vs Completed -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnTabActive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_manga_button_dark"
            android:fontFamily="@font/times_new_roman_bold"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="Active (0)"
            android:textColor="#FFFDF8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnTabCompleted"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_manga_button_secondary"
            android:fontFamily="@font/times_new_roman_bold"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="Completed (0)"
            android:textColor="#292722"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Download Tasks RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDownloadPopupList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="300dp"
        android:overScrollMode="never" />

    <TextView
        android:id="@+id/tvPopupEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:fontFamily="@font/times_new_roman_regular"
        android:gravity="center"
        android:text="No active or queued downloads"
        android:textColor="#746D62"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
