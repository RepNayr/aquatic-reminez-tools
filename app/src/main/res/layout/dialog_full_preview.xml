<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#151A21"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:id="@+id/ivFullImage"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="#090B0F"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tvFullDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/times_new_roman_regular"
        android:textColor="#9AA0A6"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnCloseFull"
        style="@style/ButtonOutline"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/times_new_roman_bold"
        android:text="Close Preview"
        android:textColor="#43D9E6" />
</LinearLayout>
