<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="24dp">

    <!-- ========== LOGO BESAR (180dp — LEBIH GEDE) ========== -->
    <androidx.cardview.widget.CardView
        android:id="@+id/iconContainer"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="90dp"
        app:cardElevation="20dp"
        app:cardBackgroundColor="@color/bg_card"
        app:strokeColor="@color/accent_red"
        app:strokeWidth="3dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/logo_app"
            android:contentDescription="@string/app_name" />
    </androidx.cardview.widget.CardView>

    <!-- ========== LABEL ========== -->
    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.5"
        android:text="// SLIDE 4 //"
        android:textColor="@color/accent_red_dark"
        android:textSize="11sp"
        app:layout_constraintTop_toBottomOf="@id/iconContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ========== TEKS JEPANG ========== -->
    <TextView
        android:id="@+id/tvJapanese"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:alpha="0.6"
        android:fontFamily="@font/times_new_roman_regular"
        android:text="開発者より"
        android:textColor="@color/accent_red"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ========== JUDUL BESAR ========== -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/cyber_blast"
        app:fontFamily="@font/cyber_blast"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:shadowColor="@color/accent_red_glow"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="30"
        android:text="AQUATIC REMINEZ TOOLS"
        android:textColor="@color/text_primary"
        android:textSize="34sp"
        app:layout_constraintTop_toBottomOf="@id/tvJapanese"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ========== SUBJUDUL ========== -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/cyber_blast"
        app:fontFamily="@font/cyber_blast"
        android:gravity="center"
        android:letterSpacing="0.4"
        android:text="BY REEP"
        android:textColor="@color/accent_red"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ========== DESKRIPSI ========== -->
    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/times_new_roman_regular"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Developed by Reep Malefitz&#10;Beginner below Beginner&#10;&#10;Version 1.0.0&#10;Build 2026"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ========== FOOTER STATUS ========== -->
    <TextView
        android:id="@+id/tvFooterStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="monospace"
        android:text="[ ACCESS GRANTED ]"
        android:textColor="@color/status_online"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>