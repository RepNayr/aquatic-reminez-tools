<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="148dp"
    android:layout_height="90dp"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_glass_card_clip"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvForexPair"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/times_new_roman_bold"
            android:textColor="@color/accent_cyan"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="USD/IDR" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/times_new_roman_regular"
            android:textColor="@color/text_muted"
            android:textSize="10.5sp"
            android:text="FX" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvForexRate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/times_new_roman_bold"
        android:textColor="@color/text_primary"
        android:textSize="13.5sp"
        android:textStyle="bold"
        tools:text="15,680.00" />

    <TextView
        android:id="@+id/tvForexChange"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/times_new_roman_bold"
        android:textColor="@color/accent_teal"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="+0.22%" />

</LinearLayout>
