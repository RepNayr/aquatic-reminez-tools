<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- DRAG HANDLE -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_dot_inactive" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/times_new_roman_bold"
        android:text="CREATE PRICE ALERT"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/times_new_roman_regular"
        android:text="Set a trigger condition for market updates"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- SELECT INSTRUMENT -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/times_new_roman_bold"
        android:text="Select Instrument"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <Spinner
        android:id="@+id/spinnerAlertInstrument"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="12dp" />

    <!-- CONDITION TYPE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/times_new_roman_bold"
        android:text="Condition Type"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <Spinner
        android:id="@+id/spinnerAlertType"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="12dp" />

    <!-- TARGET VALUE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/times_new_roman_bold"
        android:text="Target Threshold Value"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etAlertTargetValue"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:fontFamily="@font/times_new_roman_regular"
        android:hint="e.g. 95000.00"
        android:inputType="numberDecimal"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp" />

    <!-- HUMAN READABLE SUMMARY -->
    <TextView
        android:id="@+id/tvAlertSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_info_chip"
        android:fontFamily="@font/times_new_roman_regular"
        android:padding="10dp"
        android:textColor="@color/accent_cyan"
        android:textSize="12sp"
        tools:text="Trigger when BTC price rises above $95,000.00" />

    <!-- ACTIONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelAlert"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_outline"
            android:fontFamily="@font/times_new_roman_bold"
            android:text="Cancel"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp" />

        <Button
            android:id="@+id/btnSaveAlert"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_primary"
            android:fontFamily="@font/times_new_roman_bold"
            android:text="Save Alert Rule"
            android:textColor="@color/black"
            android:textSize="13.5sp" />
    </LinearLayout>

</LinearLayout>
