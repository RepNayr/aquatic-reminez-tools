<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp"
    android:paddingVertical="9dp">

    <TextView
        android:id="@+id/tvMoverRank"
        android:layout_width="20dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/times_new_roman_bold"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        tools:text="1" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMoverSymbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/times_new_roman_bold"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold"
            tools:text="NVDA" />

        <TextView
            android:id="@+id/tvMoverName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/times_new_roman_regular"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="NVIDIA Corp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMoverPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/times_new_roman_bold"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold"
            tools:text="$138.20" />

        <TextView
            android:id="@+id/tvMoverChange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/times_new_roman_bold"
            android:textColor="@color/accent_teal"
            android:textSize="11.5sp"
            android:textStyle="bold"
            tools:text="+2.52%" />
    </LinearLayout>

</LinearLayout>
