<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/containerDay"
    android:layout_width="match_parent"
    android:layout_height="42dp"
    android:layout_margin="1.5dp"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/bg_calendar_day_normal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="1dp">

        <TextView
            android:id="@+id/tvGregorianDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/times_new_roman_bold"
            android:includeFontPadding="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHijriDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0.5dp"
            android:fontFamily="@font/times_new_roman_bold"
            android:includeFontPadding="false"
            android:textColor="@color/text_secondary"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/tvJavanesePasaran"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0.5dp"
            android:fontFamily="@font/times_new_roman_bold"
            android:includeFontPadding="false"
            android:textColor="@color/accent_cyan"
            android:textSize="7sp" />

        <View
            android:id="@+id/viewUnderline"
            android:layout_width="12dp"
            android:layout_height="1dp"
            android:layout_marginTop="0.5dp"
            android:background="@color/accent_cyan"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
