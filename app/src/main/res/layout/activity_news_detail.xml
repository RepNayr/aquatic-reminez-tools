<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootNewsDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- HOMEPAGE BACKGROUND IMAGE (STATIONARY LAYER) -->
    <ImageView
        android:id="@+id/ivReaderBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/home_background_image"
        android:alpha="0.28"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <!-- DARK GRADIENT OVERLAY (STATIONARY LAYER) -->
    <View
        android:id="@+id/vReaderOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_reader_overlay"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <!-- APP BAR HEADER -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarReader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D9090B0F"
        app:elevation="4dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/toolbarReader"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/btnReaderBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_arrow_back"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:tint="@color/text_primary"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/tvReaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/times_new_roman_bold"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:text="ARTICLE READER"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnReaderBack"
                app:layout_constraintEnd_toStartOf="@id/btnReaderShare" />

            <ImageView
                android:id="@+id/btnReaderShare"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_news_action"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:tint="@color/accent_cyan"
                android:contentDescription="@string/news_share" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- READING PROGRESS INDICATOR -->
        <ProgressBar
            android:id="@+id/pbReadingProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_reader_progress_bar" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- SCROLLABLE ARTICLE CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollReaderContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="64dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- ARTICLE HEADER CONTAINER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- CATEGORY CHIP & READING TIME BADGE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvReaderCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_reader_category_chip"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:textColor="@color/accent_cyan"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        tools:text="TECHNOLOGY" />

                    <TextView
                        android:id="@+id/tvReaderReadingTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_reader_time_chip"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:textColor="@color/accent_teal"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:visibility="gone"
                        tools:text="3 MIN READ"
                        tools:visibility="visible" />

                </LinearLayout>

                <!-- HEADLINE -->
                <TextView
                    android:id="@+id/tvReaderHeadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/times_new_roman_bold"
                    android:textColor="#F0F4F8"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="4dp"
                    tools:text="Quantum Computing Breakthrough Announced by Major Tech Alliance" />

                <!-- ARTICLE DECK / SUMMARY -->
                <TextView
                    android:id="@+id/tvReaderDeck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/times_new_roman_regular"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"
                    android:visibility="gone"
                    tools:text="A new scalable error-correcting architecture promises to accelerate commercial quantum computing applications."
                    tools:visibility="visible" />

                <!-- PUBLISHER & DATE META -->
                <TextView
                    android:id="@+id/tvReaderPublisherMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/times_new_roman_regular"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    tools:text="Antara News · 12 October 2023 at 14:30 (2 hours ago)" />

                <!-- GLASS DIVIDER -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/border" />

            </LinearLayout>

            <!-- HERO IMAGE (ARTICLE THUMBNAIL) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReaderImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/bg_secondary"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/ivReaderImage"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:adjustViewBounds="true"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null"
                    tools:src="@drawable/home_background_image" />

            </com.google.android.material.card.MaterialCardView>

            <!-- FULL BODY TEXT (CLEAN EDITORIAL CANVAS, NO CARD GRID BOX) -->
            <TextView
                android:id="@+id/tvReaderBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/times_new_roman_regular"
                android:lineSpacingExtra="8dp"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                tools:text="Researchers have demonstrated a high-fidelity quantum processor capable of error correction at scale, opening doors for next-generation encryption and complex simulations." />

            <!-- SOURCE ATTRIBUTION & EXTERNAL ACTION CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="#D812151A"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#353941"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvReaderAttribution"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/times_new_roman_bold"
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp"
                        tools:text="Original full story published by Antara News." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenOriginalUrl"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Open Full Original Web Article"
                        android:textColor="@color/accent_cyan"
                        app:strokeColor="@color/accent_cyan"
                        app:strokeWidth="1dp"
                        app:cornerRadius="8dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
