<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_sheet"
    android:padding="20dp">

    <!-- HANDLE -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_info_chip" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/times_new_roman_bold"
        android:text="Filter Activity History"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxHeight="380dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- CATEGORY -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/times_new_roman_bold"
                android:text="CATEGORY"
                android:textColor="@color/accent_primary"
                android:textSize="10sp"
                android:letterSpacing="0.08" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                app:singleSelection="true"
                app:selectionRequired="false">
            </com.google.android.material.chip.ChipGroup>

            <!-- ACTIVITY TYPE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/times_new_roman_bold"
                android:text="ACTIVITY TYPE"
                android:textColor="@color/accent_primary"
                android:textSize="10sp"
                android:letterSpacing="0.08" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                app:singleSelection="true"
                app:selectionRequired="false">
            </com.google.android.material.chip.ChipGroup>

            <!-- EXECUTION STATUS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/times_new_roman_bold"
                android:text="EXECUTION STATUS (Executed only)"
                android:textColor="@color/accent_primary"
                android:textSize="10sp"
                android:letterSpacing="0.08" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                app:singleSelection="true"
                app:selectionRequired="false">
            </com.google.android.material.chip.ChipGroup>

            <!-- DATE RANGE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/times_new_roman_bold"
                android:text="DATE RANGE"
                android:textColor="@color/accent_primary"
                android:textSize="10sp"
                android:letterSpacing="0.08" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="10dp"
                app:singleSelection="true"
                app:selectionRequired="false">
            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>
    </ScrollView>

    <!-- BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetFilter"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Reset"
            android:textColor="@color/text_primary"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyFilter"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.8"
            android:layout_marginStart="6dp"
            android:text="Apply Filters"
            android:textColor="@color/black"
            app:backgroundTint="@color/accent_primary"
            style="@style/Widget.MaterialComponents.Button" />

    </LinearLayout>

</LinearLayout>
