<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.AquaticReminezTools" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent_red</item>
        <item name="colorPrimaryVariant">@color/accent_red_dark</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/accent_red</item>
        <item name="colorSecondaryVariant">@color/accent_red_dark</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/status_error</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="fontFamily">@font/times_new_roman_regular</item>
        <item name="android:fontFamily">@font/times_new_roman_regular</item>
        <item name="android:colorControlHighlight">@color/ripple_accent</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.AquaticReminezTools.Splash" parent="Theme.AquaticReminezTools">
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.AquaticReminezTools.Dialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="colorAccent">@color/accent_red</item>
        <item name="android:background">@color/bg_card</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="ButtonPrimary" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@color/accent_red</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:fontFamily">@font/times_new_roman_bold</item>
    </style>

    <style name="ButtonOutline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/accent_red</item>
        <item name="android:textSize">14sp</item>
        <item name="strokeColor">@color/accent_red</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:fontFamily">@font/times_new_roman_bold</item>
    </style>

    <style name="CardDark" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="TextPrimary">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/times_new_roman_regular</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextSecondary">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">@font/times_new_roman_regular</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/times_new_roman_bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAccent">
        <item name="android:textColor">@color/accent_red</item>
        <item name="android:fontFamily">@font/times_new_roman_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>